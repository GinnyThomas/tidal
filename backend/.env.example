# .env.example
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it contains secrets.
# This file (.env.example) is safe to commit — it has no real values.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your actual values

# --- Database ---
# Full PostgreSQL connection string.
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://tidal_user:your_password_here@localhost:5432/tidal

# --- Security ---
# Secret key used to sign JWT tokens. Must be long, random, and private.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# JWT algorithm — HS256 is the standard symmetric signing algorithm.
# You almost certainly do not need to change this.
ALGORITHM=HS256

# How many minutes a JWT access token remains valid.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Application ---
APP_NAME=Tidal

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Local development default — Vite dev server:
ALLOWED_ORIGINS=http://localhost:5173
# Production example (set this in Railway environment variables):
# ALLOWED_ORIGINS=https://your-app.vercel.app

# --- Password reset ---
# Frontend base URL used in reset-email links. Optional: if unset, the first
# ALLOWED_ORIGINS entry is used. A trailing slash is stripped either way.
# FRONTEND_URL=https://tidal-vert.vercel.app
PASSWORD_RESET_EXPIRE_MINUTES=30
# Resend API key. Leave empty locally: reset emails are printed to the
# uvicorn console instead of sent, so you can click the link from there.
# (On a non-localhost frontend a missing key logs an error, never the link.)
RESEND_API_KEY=
# Without a verified domain, onboarding@resend.dev only delivers to the
# Resend account owner's own email address.
EMAIL_FROM=Tidal <onboarding@resend.dev>

# --- Bank feeds (Enable Banking, https://enablebanking.com) ---
# Leave empty to switch bank feeds off (/bank-feeds endpoints return 503).
# Application id from the Enable Banking control panel.
ENABLE_BANKING_APPLICATION_ID=
# The application's RSA private key (PEM). On one line, write the newlines
# as literal \n — e.g. -----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
ENABLE_BANKING_PRIVATE_KEY=
